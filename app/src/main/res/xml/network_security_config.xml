<?xml version="1.0" encoding="utf-8"?>
<!-- Pixeldrain is HTTPS-only, so cleartext stays disabled globally. Media and
     CDN subdomains are reached over TLS using the system trust store. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
