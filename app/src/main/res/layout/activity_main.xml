<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background">

    <!-- Pull-to-refresh wraps the WebView. -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/page_background"
            android:scrollbars="none"
            android:overScrollMode="never" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Slim top progress bar that fills as the page loads. -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/progress_height"
        android:layout_gravity="top"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/progress_horizontal"
        android:visibility="gone" />

    <!-- Offline / error overlay (inlined so binding ids stay flat). -->
    <LinearLayout
        android:id="@+id/offlineView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/page_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_xl"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/offline_icon_size"
            android:layout_height="@dimen/offline_icon_size"
            android:contentDescription="@string/offline_title"
            android:src="@drawable/ic_offline"
            app:tint="@color/brand_primary_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/offline_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="@color/page_on_surface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center"
            android:text="@string/offline_message"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/page_on_surface_variant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/offlineRetryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:paddingHorizontal="@dimen/spacing_xl"
            android:text="@string/retry"
            app:cornerRadius="@dimen/button_corner"
            app:icon="@drawable/ic_retry" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
